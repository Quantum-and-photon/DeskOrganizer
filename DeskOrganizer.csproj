<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeskOrganizer_v2</AssemblyName>
    <RootNamespace>DeskOrganizer</RootNamespace>
    <Version>2.6.3</Version>
    <AssemblyVersion>2.6.3.0</AssemblyVersion>
    <FileVersion>2.6.3.0</FileVersion>
    <Company>Darkness</Company>
    <Product>DeskOrganizer</Product>
    <Title>桌面布局小工具</Title>
    <Copyright>Copyright © 2026 Darkness. All rights reserved.</Copyright>
    <Description>桌面图标整理与布局管理工具</Description>
    <Authors>Darkness</Authors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- 发布优化 -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 将 native DLL 也打包进单文件，避免提取路径含非 ASCII 字符时加载失败 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- SelfContained / RuntimeIdentifier 由发布命令行控制，支持自包含与依赖框架两种模式 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <ApplicationIcon>src\app.ico</ApplicationIcon>
    <!-- 调试符号不随发布包分发，减小体积 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 启用单文件压缩，减小 exe 体积 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="src\app.ico" CopyToOutputDirectory="PreserveNewest" Link="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationManifest Include="src\app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DesktopManagerDashboard\**" />
    <Content Remove="DesktopManagerDashboard\**" />
    <EmbeddedResource Remove="DesktopManagerDashboard\**" />
    <Page Remove="DesktopManagerDashboard\**" />
    <ApplicationDefinition Remove="DesktopManagerDashboard\**" />
    <Compile Remove="desk-organizer-dashboard\**" />
    <Compile Remove="desk-organizer-dashboard-draft\**" />
    <Content Remove="desk-organizer-dashboard\**" />
    <Content Remove="desk-organizer-dashboard-draft\**" />
    <Compile Remove="src\Updater\**" />
    <Content Remove="src\Updater\**" />
    <EmbeddedResource Remove="src\Updater\**" />
    <None Remove="src\Updater\**" />
  </ItemGroup>

</Project>
