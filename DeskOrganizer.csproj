<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeskOrganizer_v2</AssemblyName>
    <RootNamespace>DeskOrganizer</RootNamespace>
    <Version>2.0.4</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- 发布优化 -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SelfContained / RuntimeIdentifier 由发布命令行控制，支持自包含与依赖框架两种模式 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 调试符号不随发布包分发，减小体积 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 启用单文件压缩，减小 exe 体积 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="src\app.ico" CopyToOutputDirectory="PreserveNewest" Link="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationManifest Include="src\app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DesktopManagerDashboard\**" />
    <Content Remove="DesktopManagerDashboard\**" />
    <EmbeddedResource Remove="DesktopManagerDashboard\**" />
    <Page Remove="DesktopManagerDashboard\**" />
    <ApplicationDefinition Remove="DesktopManagerDashboard\**" />
    <Compile Remove="desk-organizer-dashboard\**" />
    <Compile Remove="desk-organizer-dashboard-draft\**" />
    <Content Remove="desk-organizer-dashboard\**" />
    <Content Remove="desk-organizer-dashboard-draft\**" />
  </ItemGroup>

</Project>
