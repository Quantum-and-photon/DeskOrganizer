<Window x:Class="DeskOrganizer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskOrganizer 设置"
        Width="520"
        Height="500"
        MinWidth="480"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="设置"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <!-- Tabs -->
        <TabControl Grid.Row="1" x:Name="TabControl">
            <!-- Tab 1: General -->
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <!-- StartWithWindows -->
                        <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
                            <CheckBox x:Name="ChkStartWithWindows" Content="开机自动启动" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- MinimizeToTray -->
                        <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
                            <CheckBox x:Name="ChkMinimizeToTray" Content="最小化到系统托盘" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- EnableBlur -->
                        <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
                            <CheckBox x:Name="ChkEnableBlur" Content="启用窗口模糊效果" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- ShowShadow -->
                        <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
                            <CheckBox x:Name="ChkShowShadow" Content="显示窗口阴影" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- AutoSave -->
                        <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
                            <CheckBox x:Name="ChkAutoSave" Content="自动保存配置" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- MarkdownRender -->
                        <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
                            <CheckBox x:Name="ChkMarkdownRender" Content="便签启用 Markdown 渲染" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Separator Margin="0,4,0,12"/>

                        <!-- Search Hotkey -->
                        <StackPanel Margin="0,4,0,12">
                            <TextBlock Text="搜索热键:" FontWeight="Medium" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="修饰键:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbHotkeyMod" Width="100" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Alt" Tag="1"/>
                                    <ComboBoxItem Content="Ctrl" Tag="2"/>
                                    <ComboBoxItem Content="Shift" Tag="4"/>
                                    <ComboBoxItem Content="Ctrl+Alt" Tag="3"/>
                                    <ComboBoxItem Content="Ctrl+Shift" Tag="6"/>
                                    <ComboBoxItem Content="Alt+Shift" Tag="5"/>
                                </ComboBox>
                                <TextBlock Text="键:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <ComboBox x:Name="CmbHotkeyKey" Width="100" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Space" Tag="32"/>
                                    <ComboBoxItem Content="F1" Tag="112"/>
                                    <ComboBoxItem Content="F2" Tag="113"/>
                                    <ComboBoxItem Content="F3" Tag="114"/>
                                    <ComboBoxItem Content="F4" Tag="115"/>
                                    <ComboBoxItem Content="F5" Tag="116"/>
                                    <ComboBoxItem Content="F6" Tag="117"/>
                                    <ComboBoxItem Content="F7" Tag="118"/>
                                    <ComboBoxItem Content="F8" Tag="119"/>
                                    <ComboBoxItem Content="F9" Tag="120"/>
                                    <ComboBoxItem Content="F10" Tag="121"/>
                                    <ComboBoxItem Content="F11" Tag="122"/>
                                    <ComboBoxItem Content="F12" Tag="123"/>
                                    <ComboBoxItem Content="Q" Tag="81"/>
                                    <ComboBoxItem Content="S" Tag="83"/>
                                    <ComboBoxItem Content="F" Tag="70"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="提示: 更改热键后需重启程序生效。" Foreground="#666666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Fences -->
            <TabItem Header="围栏">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <!-- IconSize -->
                        <StackPanel Margin="0,4,0,12">
                            <TextBlock Text="图标大小:" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SliderIconSize" Minimum="16" Maximum="128" Value="48"
                                        Width="200" VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True" TickFrequency="16"/>
                                <TextBlock x:Name="TxtIconSize" Text="48" Width="40" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- TitleHeight -->
                        <StackPanel Margin="0,4,0,12">
                            <TextBlock Text="标题栏高度:" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SliderTitleHeight" Minimum="20" Maximum="60" Value="32"
                                        Width="200" VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True" TickFrequency="2"/>
                                <TextBlock x:Name="TxtTitleHeight" Text="32" Width="40" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Sticky Notes -->
            <TabItem Header="便签">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <!-- FontSize -->
                        <StackPanel Margin="0,4,0,12">
                            <TextBlock Text="默认字体大小:" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SliderFontSize" Minimum="10" Maximum="32" Value="14"
                                        Width="200" VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock x:Name="TxtFontSize" Text="14" Width="40" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Data -->
            <TabItem Header="数据">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="配置路径:" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtConfigPath" Foreground="#666666" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="备份路径:" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtBackupPath" Foreground="#666666" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="最后保存时间:" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtLastSaved" Foreground="#666666"/>
                        </StackPanel>
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="备份数量:" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtBackupCount" Foreground="#666666"/>
                        </StackPanel>

                        <Separator Margin="0,12,0,12"/>

                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="备份管理:" FontWeight="Medium" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox x:Name="ChkAutoCleanBackups" Content="自动清理旧备份" VerticalAlignment="Center"/>
                                <TextBlock Text="保留数量:" Margin="16,0,4,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtMaxBackupCount" Width="50" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="存储上限 (MB，0=不限制):" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtStorageLimit" Width="80"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="搜索索引文件上限:" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSearchIndexLimit" Width="80"/>
                        </StackPanel>

                        <Separator Margin="0,12,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button x:Name="BtnBackupNow" Content="立即备份" Width="100" Margin="0,0,12,0" Click="BtnBackupNow_Click"/>
                            <Button x:Name="BtnRestoreBackup" Content="恢复备份" Width="100" Click="BtnRestoreBackup_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnSave" Content="保存" Width="80" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="取消" Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
