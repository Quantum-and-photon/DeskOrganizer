<Window x:Class="DeskOrganizer.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索"
        Width="600"
        Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Deactivated="Window_Deactivated">

    <Border Background="#F8F8F8"
            CornerRadius="8"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Input -->
            <Grid Grid.Row="0">
                <TextBox x:Name="SearchBox"
                         Height="40"
                         FontSize="16"
                         Padding="12,8"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown"
                         BorderBrush="#CCCCCC"/>
                <TextBlock x:Name="PlaceholderText"
                           Text="搜索文件名、路径或扩展名..."
                           FontSize="16"
                           Foreground="#AAAAAA"
                           Padding="14,8"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Indexing Progress -->
            <Grid Grid.Row="1" Margin="0,8,0,4">
                <TextBlock x:Name="ProgressText"
                           Text="准备就绪"
                           FontSize="11"
                           Foreground="#888888"
                           VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBar"
                             Height="3"
                             VerticalAlignment="Bottom"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Visibility="Collapsed"/>
            </Grid>

            <!-- Results List -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="2"
                     Margin="0,4,0,4"
                     Background="White"
                     BorderBrush="#EEEEEE"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                     KeyDown="ResultsList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Image Source="{Binding Icon}"
                                   Width="24"
                                   Height="24"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- File Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DisplayPath}"
                                           FontSize="11"
                                           Foreground="#888888"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Size & Date -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,4,0">
                                <TextBlock Text="{Binding DisplaySize}"
                                           FontSize="11"
                                           Foreground="#888888"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DisplayDate}"
                                           FontSize="11"
                                           Foreground="#AAAAAA"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Status Bar -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       FontSize="11"
                       Foreground="#AAAAAA"
                       Text="Alt+Space 打开 | 输入关键词搜索 | Enter 打开 | Esc 关闭"/>
        </Grid>
    </Border>
</Window>
