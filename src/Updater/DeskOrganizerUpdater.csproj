<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeskOrganizerUpdater</AssemblyName>
    <RootNamespace>DeskOrganizer.Updater</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Company>Darkness</Company>
    <Product>DeskOrganizer Updater</Product>
    <Title>DeskOrganizer Updater</Title>
    <Copyright>Copyright © 2026 Darkness. All rights reserved.</Copyright>
    <Description>DeskOrganizer auto-update helper</Description>
    <Authors>Darkness</Authors>
  </PropertyGroup>

</Project>
