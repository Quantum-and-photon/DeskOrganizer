<Window x:Class="DeskOrganizer.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="480" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border x:Name="MainBorder" CornerRadius="14" Padding="0"
            Background="#FAFAF9"
            BorderBrush="#E7E5E4"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.12" Color="#1A1614"/>
        </Border.Effect>
        <StackPanel>
            <!-- 图标区 -->
            <Grid Height="64" Margin="0,24,0,0">
                <Ellipse Width="56" Height="56" Fill="#FEF3C7" x:Name="IconCircle"/>
                <TextBlock x:Name="IconText" Text="⚠" FontSize="28" Foreground="#F59E0B"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Segoe UI Emoji"/>
            </Grid>

            <!-- 标题 -->
            <TextBlock x:Name="TitleText" Text="确认操作"
                       FontSize="16" FontWeight="SemiBold" Foreground="#1C1917"
                       HorizontalAlignment="Center" Margin="24,12,24,4"
                       FontFamily="Microsoft YaHei UI"/>

            <!-- 消息 -->
            <TextBlock x:Name="MessageText" Text=""
                       FontSize="13" Foreground="#57534E"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="24,4,24,8"
                       FontFamily="Microsoft YaHei UI" MaxWidth="420"/>

            <!-- 警告提示 -->
            <Border x:Name="WarningBanner" CornerRadius="8" Padding="12,8" Margin="24,4,24,16"
                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="14" Foreground="#DC2626" VerticalAlignment="Center"
                               FontFamily="Segoe UI Emoji" Margin="0,0,8,0"/>
                    <TextBlock x:Name="WarningText" Text="" FontSize="12" Foreground="#991B1B"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               FontFamily="Microsoft YaHei UI" MaxWidth="380"/>
                </StackPanel>
            </Border>

            <!-- 按钮区 -->
            <Grid Margin="24,0,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="0" Content="取消"
                        Height="36" FontSize="13" FontWeight="Medium"
                        Background="#FFFFFF" Foreground="#57534E"
                        BorderBrush="#E7E5E4" BorderThickness="1"
                        Cursor="Hand" Click="CancelButton_Click"
                        FontFamily="Microsoft YaHei UI">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ConfirmButton" Grid.Column="2" Content="确定"
                        Height="36" FontSize="13" FontWeight="SemiBold"
                        Background="#DC2626" Foreground="#FFFFFF"
                        BorderThickness="0" Cursor="Hand" Click="ConfirmButton_Click"
                        FontFamily="Microsoft YaHei UI">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ConfirmBorder" CornerRadius="8" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#B91C1C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
